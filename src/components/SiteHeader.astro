---
interface Props {
  /** Path of the primary-nav section this page belongs to, for aria-current. */
  current?: string;
  /** "page" when the page is the nav target itself, "true" for pages inside the section. */
  kind?: 'page' | 'true';
}
const { current, kind = 'page' } = Astro.props;
const links = [
  { href: '/experience/', label: 'Experience' },
  { href: '/ai/', label: 'AI Work' },
  { href: '/lab/', label: 'Engineering Lab' },
  { href: '/ideas/', label: 'Ideas' },
  { href: '/fun/', label: 'Fun' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">David Wayne Baxter</a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      {links.map((l) => <a href={l.href} aria-current={l.href === current ? kind : undefined}>{l.label}</a>)}
      <a href="https://www.linkedin.com/in/davidwbaxter/" rel="me noopener" target="_blank">LinkedIn&nbsp;↗<span class="sr-only"> (opens in a new tab)</span></a>
      <button type="button" class="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>

<style>
.site-header { border-bottom: 1px solid var(--rule); }
.site-header .wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.5rem 2rem;
  padding-block: 1.25rem;
}
.brand { font: 500 1.3rem/1.2 var(--serif); text-decoration: none; letter-spacing: -0.005em; }
.brand:hover { color: inherit; }
.site-nav { display: flex; align-items: center; gap: 1.75rem; font-size: 0.95rem; }
.site-nav a { text-decoration: none; padding-block: 0.15rem; border-bottom: 1px solid transparent; white-space: nowrap; }
.site-nav a:hover { color: var(--ink); border-bottom-color: var(--accent); }
.site-nav a[aria-current="page"] { border-bottom-color: var(--ink); }
@media (max-width: 52rem) {
  .site-nav { flex-wrap: wrap; gap: 0.4rem 1.1rem; }
}
@media print {
  .site-header { display: none; }
}
.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  margin: -0.4rem -0.55rem -0.4rem -0.75rem;
  padding: 0;
  background: none;
  border: 0;
  border-radius: 2px;
  color: var(--ink);
  cursor: pointer;
}
.theme-toggle:hover { color: var(--accent); }
.theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.theme-toggle svg {
  width: 1.15rem;
  height: 1.15rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.theme-toggle .icon-sun { display: none; }
:global(:root[data-theme="dark"]) .theme-toggle .icon-sun { display: block; }
:global(:root[data-theme="dark"]) .theme-toggle .icon-moon { display: none; }
.site-nav a[aria-current="true"] { border-bottom-color: var(--ink); }
.menu-toggle { display: none; }
@media (max-width: 52rem) {
  .site-header .wrap { position: relative; }
  :global(.js) .brand { max-width: calc(100% - 7.75rem); }
  :global(.js) .menu-toggle, :global(.js) .theme-toggle { position: absolute; top: 0.9rem; margin: 0; }
  :global(.js) .theme-toggle { right: var(--gutter); }
  :global(.js) .menu-toggle {
    right: calc(var(--gutter) + 2.6rem);
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 0.8rem;
    font: 400 0.8125rem/1 var(--mono);
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    cursor: pointer;
  }
  :global(.js) .menu-toggle:hover { color: var(--accent); border-color: var(--accent); }
  :global(.js) .menu-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(.js) .site-nav:not(.open) a { display: none; }
  :global(.js) .site-nav.open {
    flex: 1 0 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin-top: 0.85rem;
    border-top: 1px solid var(--ink);
  }
  :global(.js) .site-nav.open a { padding: 0.95rem 0; border-bottom: 1px solid var(--rule); font-size: 1.05rem; }
  :global(.js) .site-nav.open a[aria-current] { padding-left: 0.85rem; border-left: 2px solid var(--accent); font-weight: 500; }
}</style>
