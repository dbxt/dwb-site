---
import Base from '../../layouts/Base.astro';
import { crumbs, article } from '../../lib/schema.js';

const schema = [
  crumbs([["Home", "/"], ["Contact", "/contact/"]]),
  {
    "@type": "ContactPage",
    "url": "https://davidwaynebaxter.com/contact/",
    "name": "Contact | David Wayne Baxter"
  },
];
---
<Base
  schema={schema}
  title="Contact | David Wayne Baxter"
  description="Contact David Wayne Baxter about Senior Engineering Manager and Director of Engineering opportunities. LinkedIn is the best way to reach him."
  canonical="/contact/"
  ogDescription="Open to Senior Engineering Manager and Director of Engineering opportunities. Reach out on LinkedIn."
  navCurrent="/contact/"
  navKind="page"
>
<main id="main">
    <div class="wrap">

      <div class="page-head">
        <p class="mono">Contact</p>
        <h1>Let’s talk about your engineering organization.</h1>
        <p class="lede">I am open to Senior Engineering Manager and Director of Engineering opportunities. LinkedIn is the best way to reach me, and my profile there has my full work history and recommendations.</p>
        <p class="lede muted">I am between roles and building TechDrift, a signal-discovery product I designed, shipped, and now run with AI agents. <a class="textlink" href="/ai/signaldrift/">See the case study&nbsp;→</a></p>
        <div class="actions">
          <a class="button" href="https://www.linkedin.com/in/davidwbaxter/" rel="me noopener" target="_blank">Message me on LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>

      <div class="spec-wrap">
        <dl class="spec">
          <div><dt>Roles of interest</dt><dd>Senior Engineering Manager · Director of Engineering</dd></div>
          <div><dt>Most recent role</dt><dd>Senior Engineering Manager, Fanatics Betting and Gaming (March 2023 – September 2026)</dd></div>
          <div><dt>Location</dt><dd>Los Angeles metropolitan area</dd></div>
          <div><dt>Best channel</dt><dd><a href="https://www.linkedin.com/in/davidwbaxter/" rel="me noopener" target="_blank">linkedin.com/in/davidwbaxter<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
          <div><dt>GitHub</dt><dd><a href="https://github.com/dbxt" rel="me noopener" target="_blank">github.com/dbxt<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
          <div><dt>All profiles</dt><dd><a href="/connect/">davidwaynebaxter.com/connect</a></dd></div>
          <div><dt>Docker Hub</dt><dd><a href="https://hub.docker.com/u/dbxt" rel="me noopener" target="_blank">hub.docker.com/u/dbxt<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
        </dl>
      </div>

    </div>
  </main>
</Base>
