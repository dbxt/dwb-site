---
import Base from '../layouts/Base.astro';
import '../styles/results.css';
import { latest } from '../lib/pages.js';

const recent = latest(3);
import { crumbs, article } from '../lib/schema.js';

const schema = [
  {
    "@type": "WebSite",
    "@id": "https://davidwaynebaxter.com/#website",
    "name": "David Wayne Baxter",
    "publisher": {
      "@id": "https://davidwaynebaxter.com/#person"
    },
    "url": "https://davidwaynebaxter.com/"
  },
  {
    "@type": "Person",
    "@id": "https://davidwaynebaxter.com/#person",
    "name": "David Wayne Baxter",
    "givenName": "David",
    "additionalName": "Wayne",
    "familyName": "Baxter",
    "mainEntityOfPage": "https://davidwaynebaxter.com/",
    "disambiguatingDescription": "Software engineering leader and builder of TechDrift; not the country music artist of the same name.",
    "alternateName": "Bax",
    "description": "Engineering leader with 20+ years in software leadership, specializing in platform engineering, observability, AI-augmented workflows, and building high-retention engineering teams.",
    "url": "https://davidwaynebaxter.com/",
    "image": "https://davidwaynebaxter.com/assets/headshot-20260906.jpg?v=20260906",
    "jobTitle": "Engineering Leader",
    "knowsAbout": [
      "engineering management",
      "director of engineering",
      "platform engineering",
      "observability",
      "site reliability",
      "AI-augmented engineering",
      "agentic workflows",
      "engineering leadership",
      "team retention",
      "developer experience",
      "Datadog",
      "Terraform",
      "AWS",
      "continuous delivery",
      "engineering operating systems"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "addressCountry": "US"
    },
    "sameAs": [
      "https://www.linkedin.com/in/davidwbaxter",
      "https://github.com/dbxt",
      "https://mentorcruise.com/mentor/davidbaxter/",
      "https://dev.to/davidwaynebax",
      "https://x.com/davidwaynebax",
      "https://bsky.app/profile/davidwaynebax",
      "https://www.threads.com/@davidwaynebax",
      "https://www.instagram.com/davidwaynebax/",
      "https://www.tiktok.com/@davidwaynebax"
    ]
  },
];
---
<Base
  schema={schema}
  title={"David Wayne Baxter | Engineering Leader, Platform Reliability & AI Agents"}
  description="David Wayne Baxter is a software engineering leader in Los Angeles with 20+ years of experience in platform reliability, observability and AI-agent workflows. Open to Senior Engineering Manager and Director roles."
  canonical="/"
  ogDescription="Engineering leader with 20+ years of experience building reliable platforms and teams that stay together."
>
<main id="main">
    <div class="wrap">

      <section class="hero" aria-labelledby="intro">
        <div>
          <p class="mono eyebrow">Engineering leader · Los Angeles, California</p>
          <h1 id="intro">Engineering leadership through better systems.</h1>
          <p class="lede">I lead engineering teams that ship reliably and stay together, and I build the platforms, observability, delivery process, and AI-enabled workflows that make an engineering organization faster, more reliable, and easier to lead.</p>
          <p class="lede muted">I am an engineering leader with more than twenty years in software, and coworkers and friends call me Bax. Most recently, at Fanatics Betting and Gaming, I led the teams behind content delivery, the CMS, and shared platform services for a sportsbook and retail product on web and mobile. I have also worked as a developer, architect, CTO, and director.</p>
          <p class="lede muted">My approach is consistent. I learn the system quickly, agree with the business on what it needs, turn that into work engineers can act on, and put in place the process and tooling that make good delivery repeatable.</p>
          <p class="lede muted">I am between roles and building TechDrift, a signal-discovery product I designed, shipped, and now run with AI agents. <a class="textlink" href="/ai/signaldrift/">See the case study&nbsp;→</a></p>
          <div class="actions">
            <a class="button" href="https://www.linkedin.com/in/davidwbaxter/" rel="me noopener" target="_blank">Connect on LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
            <a class="textlink" href="/experience/">Read the full experience&nbsp;→</a>
          </div>
        </div>
        <figure class="portrait">
          <img src="/assets/headshot-20260906-640.webp" srcset="/assets/headshot-20260906-400.webp 400w, /assets/headshot-20260906-640.webp 640w, /assets/headshot-20260906-960.webp 960w" sizes="(min-width: 62rem) 19.5rem, (min-width: 28rem) 22rem, calc(100vw - 2.5rem)" width="962" height="1280" alt="Portrait of David Wayne Baxter" decoding="async" />
        </figure>
      </section>

      <div class="spec-wrap">
        <dl class="spec">
          <div><dt>Most recent role</dt><dd>Senior Engineering Manager, Fanatics Betting and Gaming (March 2023 – September 2026)</dd></div>
          <div><dt>Availability</dt><dd>Senior Engineering Manager or Director of Engineering</dd></div>
          <div><dt>Team scope</dt><dd>Typically 8–12 direct reports; a peak of 11 at Fanatics and close to 20 at Stayhealthy</dd></div>
          <div><dt>Career range</dt><dd>Developer, architect, CTO, director, and manager, across 20+ years</dd></div>
          <div><dt>Industries</dt><dd>Sportsbook and betting, automotive e-commerce, language learning, digital health</dd></div>
          <div><dt>Technology</dt><dd>Java, Kotlin, PostgreSQL, AWS, Datadog, Terraform, Jira and Atlassian tools</dd></div>
        </dl>
      </div>

      <section class="row first" aria-labelledby="results">
        <div class="label">Selected results</div>
        <div class="body">
          <h2 id="results">Scale and outcomes, in numbers.</h2>
          <div class="result">
            <div class="figure">1,000×</div>
            <p>faster responses from the content delivery service that replaced a GraphQL service, cutting latency from 30–60 seconds to 30–60 milliseconds, with no production incidents for over six months and no issues on Super Bowl traffic.</p>
          </div>
          <div class="result">
            <div class="figure">200+</div>
            <p>monitors generated with Terraform from a template, so every new endpoint and service gets standard coverage of latency, errors, memory, CPU, and SLOs, with P1 incidents paging automatically.</p>
          </div>
          <div class="result">
            <div class="figure">6</div>
            <p>promotions on my team over three and a half years, including an engineer who moved into engineering management, with only one voluntary departure.</p>
          </div>
          <div class="result">
            <div class="figure">4 → 20</div>
            <p>engineers, as I grew the Stayhealthy development organization across UI/UX, front end, services, and database administration.</p>
          </div>
          <div class="result">
            <div class="figure">8–12</div>
            <p>direct reports in a typical assignment, from early-career engineers to Senior Staff, with a peak of 11 at Fanatics and close to 20 at Stayhealthy.</p>
          </div>
        </div>
      </section>

      <section class="row" aria-labelledby="build">
        <div class="label">What I build</div>
        <div class="body wide">
          <h2 id="build">The organizational problems I take on.</h2>
          <ul class="build-grid">
            <li class="build-card">
              <h3>Engineering operating systems</h3>
              <p>The visibility and safety nets that let teams ship often: more than 200 Terraform-generated monitors with automatic P1 paging, rollback automation, and capacity and sprint data that show where a team really stands.</p>
              <a class="textlink" href="/experience/">See the experience&nbsp;→</a>
            </li>
            <li class="build-card">
              <h3>Platforms that scale</h3>
              <p>Shared services and delivery platforms that carry real traffic: a content delivery service about a thousand times faster than the GraphQL service it replaced, migrated one endpoint at a time, and a consolidated content platform across languages and regions.</p>
              <a class="textlink" href="/experience/content-delivery-service/">Read the case study&nbsp;→</a>
            </li>
            <li class="build-card">
              <h3>AI-augmented engineering</h3>
              <p>Agents that do defined jobs inside an engineering organization: scanning repositories for bugs and opening fix pull requests, assessing team capacity and suggesting one-on-one topics, and running a print-on-demand shop end to end.</p>
              <a class="textlink" href="/ai/">See the AI work&nbsp;→</a>
            </li>
          </ul>
        </div>
      </section>

      <section class="row" aria-labelledby="outcomes" id="team-outcomes">
        <div class="label">Team outcomes</div>
        <div class="body wide">
          <h2 id="outcomes">What happened to the people I led.</h2>
          <p class="lede muted">The numbers behind this are in <a class="textlink" href="#results">selected results&nbsp;↑</a>. <a class="textlink" href="/ideas/what-keeps-engineers/">How I kept retention high&nbsp;→</a></p>
          <ul class="build-grid">
            <li class="build-card">
              <h3>Managers developed</h3>
              <p>One engineer on my team moved into engineering management.</p>
            </li>
            <li class="build-card">
              <h3>Hiring</h3>
              <p>Built the Fanatics team from one engineer, welcomed two internal transfers who asked to join, and assessed 12 engineers in an acqui-hire, bringing on the five we committed to.</p>
            </li>
            <li class="build-card">
              <h3>Mentoring beyond my reporting line</h3>
              <p>I mentor engineers outside my own teams, including as a MentorCruise mentor in 2022, coaching junior and mid-level engineers on interviews, code reviews, and visibility.</p>
            </li>
            <li class="build-card">
              <h3>Growth programs</h3>
              <p>Tech talks, innovation projects, and short-term goals kept skills growing, and I wrote <i>Motivating Your Team: Continual Improvement Sessions</i>.</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="row" aria-labelledby="approach">
        <div class="label">How I lead</div>
        <div class="body">
          <h2 id="approach">Five working principles.</h2>
          <div class="principle">
            <h3>Learn the system before changing it.</h3>
            <p>I have a record of joining active projects and teams, understanding how they actually work, and improving efficiency and quality of output without interrupting delivery.</p>
          </div>
          <div class="principle">
            <h3>Turn priorities into work engineers can act on.</h3>
            <p>I work with product managers and stakeholders to define scope and requirements and to set expectations early, so that developers receive clear tasks and everyone knows what will be delivered.</p>
          </div>
          <div class="principle">
            <h3>Make the safe path the easy path.</h3>
            <p>Reliability and release confidence are engineering products in their own right. I invest in observability, automated validation, and rollback automation so that teams can ship often without depending on individual heroics.</p>
          </div>
          <div class="principle">
            <h3>Hire for the team, not just the résumé.</h3>
            <p>I weigh compatibility, personality, and drive alongside technical ability when I hire. Teams built that way work well together, and they excel together. <a class="textlink" href="/ideas/what-keeps-engineers/#interview">How I interview&nbsp;→</a></p>
          </div>
          <div class="principle">
            <h3>Invest in the people doing the work.</h3>
            <p>I learn each engineer’s goals and build career paths with clear milestones. Tech talks, innovation projects, and short-term goals keep skills growing, and the result has been dedicated teams with near-flawless retention, including through changes of priority. I also mentor engineers outside my own teams.</p>
          </div>
        </div>
      </section>

      <section class="row" aria-labelledby="colleagues">
        <div class="label">What colleagues say</div>
        <div class="body">
          <h2 id="colleagues" class="sr-only">What colleagues say</h2>
          <blockquote class="pull">
            <p>“In my eyes, he is the ideal people manager.”</p>
            <footer><cite>David Yoon</cite> · Software Engineer, Netflix · reported to David directly · October 2026</footer>
          </blockquote>
          <div class="quotes">
            <blockquote class="quote">
              <p>“David was my manager for the better part of two years building out Fanatics Sportsbook. He is always looking out for his engineers, identifying the best ways each one likes to work, and empowering them to do their best work. He is very transparent in his belief of protecting the engineer from the red tape that comes with working at a relatively large firm. I feel fortunate to have worked under David, as he was directly responsible for the growth I have experienced in my career, and would love to work with him again in the future.”</p>
              <footer><cite>David Yoon</cite> · Software Engineer, Netflix · reported to David directly · October 2026</footer>
            </blockquote>
            <blockquote class="quote">
              <p>“He is truly one of the most talented engineers and leaders I have worked with.”</p>
              <footer><cite>Scott Gay</cite> · Multifaceted Engineering Leader · managed David directly · April 2017</footer>
            </blockquote>
            <blockquote class="quote">
              <p>“David is always looking for ways to improve the systems he owns and streamline processes to create better outcomes for his stakeholders such as researching new technologies or evaluating previous tools that have been implemented and making sure that they are serving the purpose for the business. David would be a great asset to any organization and I look forward to working with him again in the future!”</p>
              <footer><cite>Wyatt Yates</cite> · Sr. Manager, Software Engineering · managed David directly · February 2022</footer>
            </blockquote>
            <blockquote class="quote">
              <p>“David is a great manager, developer, and a great manager of developers. During my time working with David, he’s always been very transparent with communicating that he has the back of his team, while proving it by putting his neck on the line for us time after time.”</p>
              <footer><cite>Tyler Greulich</cite> · Senior Frontend/Full-Stack Developer · reported to David directly · February 2022</footer>
            </blockquote>
            <blockquote class="quote">
              <p>“Any team will thrive and flourish under David’s expert leadership.”</p>
              <footer><cite>Luke Morris</cite> · Quality Assurance Analyst · reported to David directly · February 2022</footer>
            </blockquote>
            <blockquote class="quote">
              <p>“He is a problem solver and plain and simply gets things done.”</p>
              <footer><cite>Kevin Strom</cite> · Vice President of Sales, VXI Global · managed David directly · April 2017</footer>
            </blockquote>
          </div>
          <p class="mono more">Excerpts from LinkedIn recommendations.</p>
        </div>
      </section>

      <section class="row" aria-labelledby="recent">
        <div class="label">Recent roles</div>
        <div class="body">
          <h2 id="recent">Where the work happened.</h2>
          <ol class="log">
            <li><time>2023 – 2026</time><span>Senior Engineering Manager, <b>Fanatics Betting and Gaming</b></span></li>
            <li><time>2022 – 2023</time><span>Engineering Manager, <b>Carvana</b></span></li>
            <li><time>2017 – 2022</time><span>Engineering Manager, <b>Rosetta Stone</b></span></li>
            <li><time>2016 – 2017</time><span>CTO, <b>GlobeChat</b></span></li>
            <li><time>2011 – 2013</time><span>Director of Software Development, <b>Stayhealthy</b></span></li>
          </ol>
          <p class="more"><a class="textlink" href="/experience/">Responsibilities and results for each role&nbsp;→</a></p>
        </div>
      </section>

      <section class="row" aria-labelledby="ai-work">
        <div class="label">AI work</div>
        <div class="body">
          <h2 id="ai-work" class="tight">Agents, dashboards, and a ranked list of bugs.</h2>
          <p>Five projects show how I apply AI. One shared evidence engine runs three live products, <a class="textlink" href="https://techdrift.app/?utm_source=davidwaynebaxter&amp;utm_medium=portfolio&amp;utm_campaign=signaldrift_case_study&amp;utm_content=techdrift_home_inline" target="_blank" rel="noopener">TechDrift</a>, <a class="textlink" href="https://gamingdrift.app/?utm_source=davidwaynebaxter&amp;utm_medium=portfolio&amp;utm_campaign=signaldrift_case_study&amp;utm_content=gamingdrift_home_inline" target="_blank" rel="noopener">GamingDrift</a>, and <a class="textlink" href="https://sportsdrift.app/?utm_source=davidwaynebaxter&amp;utm_medium=portfolio&amp;utm_campaign=signaldrift_case_study&amp;utm_content=sportsdrift_home_inline" target="_blank" rel="noopener">SportsDrift</a>, that I started building during my time at Fanatics and have kept building since. A dashboard built with Claude scores a team’s sprint health. Nine AI agents run a live print-on-demand shop, taking each product from request to listing. Claude agents scan repositories, file a ranked list of bugs, and open pull requests to fix them. And an AI-configured dashboard is the front door to my lab. Each has a write-up of the design and how AI was used.</p>
          <div class="actions">
            <a class="textlink" href="/ai/signaldrift/">TechDrift&nbsp;→</a>
            <a class="textlink" href="/ai/em-dashboard/">Sprint Ledger&nbsp;→</a>
            <a class="textlink" href="/ai/drop-shipping-automation/">Drop Shipping Automation&nbsp;→</a>
            <a class="textlink" href="/ai/bug-manager/">Bug Manager&nbsp;→</a>
            <a class="textlink" href="/ai/homepage/">Homepage Dashboard&nbsp;→</a>
            <a class="textlink" href="/ai/">All AI work&nbsp;→</a>
          </div>
        </div>
      </section>

      <section class="row" aria-labelledby="latest">
        <div class="label">Latest</div>
        <div class="body">
          <h2 id="latest">New on the site.</h2>
          <ol class="log">
            {recent.map((p) => (
              <li><time datetime={p.date}>{p.label}</time><span><a class="textlink" href={p.url}>{p.title}</a> <span class="where">· {p.section}</span></span></li>
            ))}
          </ol>
          <div class="actions">
            <a class="textlink" href="/ideas/">Ideas&nbsp;→</a>
            <a class="textlink" href="/ai/">AI Work&nbsp;→</a>
            <a class="textlink" href="/lab/">Engineering Lab&nbsp;→</a>
            <a class="textlink" href="/fun/">Fun&nbsp;→</a>
          </div>
        </div>
      </section>

      <section class="row" aria-labelledby="exploring">
        <div class="label">Currently exploring</div>
        <div class="body">
          <h2 id="exploring" class="tight">What I&rsquo;m exploring now.</h2>
          <ul class="plain">
            <li><a class="textlink" href="/ai/">Agentic software development</a></li>
            <li>AI-assisted engineering management</li>
            <li>Autonomous operations</li>
            <li>Developer experience</li>
            <li><a class="textlink" href="/lab/">Self-hosted and private infrastructure</a></li>
            <li>Organizational design for human + AI teams</li>
          </ul>
          <p class="muted">Updated September 2026.</p>
        </div>
      </section>

      <section class="row" aria-labelledby="credentials">
        <div class="label">Credentials</div>
        <div class="body">
          <h2 id="credentials">Certifications, writing, and education.</h2>
          <dl class="spec">
            <div><dt>Certifications</dt><dd>Microsoft Certified Professional<br />Certificate of Completion: AI Fluency Framework &amp; Foundations</dd></div>
            <div><dt>Publication</dt><dd><i>Motivating Your Team: Continual Improvement Sessions</i></dd></div>
            <div><dt>Education</dt><dd>San Joaquin Delta College, computer science coursework (1995–1998); no degree</dd></div>
            <div><dt>Core skills</dt><dd>Engineering management and team building, performance management and promotion planning, platform reliability and observability (Terraform, Datadog, SLOs), incremental and zero-downtime migrations, AI fluency and agentic engineering workflows</dd></div>
          </dl>
        </div>
      </section>

      <section class="row" aria-labelledby="contact">
        <div class="label">Contact</div>
        <div class="body">
          <h2 id="contact" class="tight">Get in touch.</h2>
          <p>LinkedIn is the best way to reach me.</p>
          <div class="actions">
            <a class="button" href="https://www.linkedin.com/in/davidwbaxter/" rel="me noopener" target="_blank">Message me on LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </section>

    </div>
  </main>
</Base>

<style>
.hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; padding-block: clamp(2.5rem, 7vw, 5.5rem) 3.5rem; }
.hero .eyebrow { margin-bottom: 1.5rem; }
.hero h1 { margin-bottom: 1.75rem; max-width: 14em; }
.hero .portrait { max-width: 22rem; }
.hero .portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border: 1px solid var(--rule); }
@media (min-width: 62rem) {
  .hero { grid-template-columns: minmax(0, 1fr) 19.5rem; gap: 4.5rem; align-items: start; }
  .hero .portrait { margin-top: 3.25rem; max-width: none; }
}
.log .where { color: var(--muted); }
.more { margin: 1.5rem 0 0; }
.quotes { margin-top: 2.5rem; }
blockquote.quote { margin: 0; padding-block: 1.6rem; border-top: 1px solid var(--rule); }
blockquote.quote p { font: 400 1.15rem/1.55 var(--serif); margin-bottom: 0.75rem; }
blockquote.quote footer { font: 400 0.8125rem/1.6 var(--mono); color: var(--muted); }
blockquote.quote cite { font-style: normal; color: var(--ink); font-weight: 400; }
.build-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin: 0; padding: 0; list-style: none; }
@media (min-width: 40rem) {
  .build-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
.build-card {
  display: grid;
  gap: 0.7rem;
  align-content: start;
  padding: 1.35rem 1.5rem;
  border: 1px solid var(--rule);
  border-radius: 2px;
}
.build-card h3 { margin: 0; }
.build-card p { margin: 0; color: var(--muted); }
.build-card .textlink { justify-self: start; margin-top: 0.15rem; }
</style>
