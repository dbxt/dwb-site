{
  "ci": {
    "collect": {
      "url": [
        "https://dev.davidwaynebaxter-com.pages.dev/",
        "https://dev.davidwaynebaxter-com.pages.dev/ai/",
        "https://dev.davidwaynebaxter-com.pages.dev/ai/bug-manager/",
        "https://dev.davidwaynebaxter-com.pages.dev/ai/signaldrift/",
        "https://dev.davidwaynebaxter-com.pages.dev/experience/",
        "https://dev.davidwaynebaxter-com.pages.dev/connect/",
        "https://dev.davidwaynebaxter-com.pages.dev/ideas/",
        "https://dev.davidwaynebaxter-com.pages.dev/lab/proxmox/opnsense/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300,
            "aggregationMethod": "median"
          }
        ]
      }
    }
  }
}
