# Legacy FTPS host only (Cloudflare Pages ignores this file and reads _redirects and _headers instead).
# Keep the redirects and headers here in step with public/_redirects and public/_headers.
# Canonical URLs: one https, non-www address per page.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex in a single hop
  RewriteCond %{HTTP_HOST} ^www\.davidwaynebaxter\.com$ [NC]
  RewriteRule ^(.*)$ https://davidwaynebaxter.com/$1 [R=301,L]

  # /dir/index.html -> /dir/ (only when requested that way, so the internal DirectoryIndex lookup is untouched)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ https://davidwaynebaxter.com/$1 [R=301,L]

  # The Homelab section became the Engineering Lab at /lab/. Both earlier addresses redirect straight to it.
  RewriteRule ^(?:homelab|engineering-lab)/?$ /lab/ [R=301,L]
  RewriteRule ^(?:homelab|engineering-lab)/(.+?)/?$ /lab/$1/ [R=301,L]

  # The AI and engineering leadership essay moved from AI Work to Ideas.
  RewriteRule ^ai/ai-and-engineering-leadership/?$ /ideas/ai-and-engineering-leadership/ [R=301,L]

  # The embedded Bug Manager demo moved to its dedicated project host.
  RewriteRule ^ai/bug-manager/demo/?$ https://bug-manager.projects.davidwaynebaxter.com/ [R=301,L]
</IfModule>

# Retired duplicates of /contact/ and /experience/
Redirect 301 /contact.html /contact/
Redirect 301 /experience.html /experience/

# Custom 404 page (keeps the 404 status code)
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest

# Security headers. HSTS is scoped to this host only (no includeSubDomains) so the app subdomains are unaffected.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://techdrift.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
